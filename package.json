{
  "name": "solana-trading-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Educational Telegram trading bot for Solana (BonkBot/Trojan-style) using grammY + Jupiter v6",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@solana/web3.js": "^1.95.3",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "ed25519-hd-key": "^2.0.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
